# AutoDev Assistant Configuration
# Copy this file to .env and fill in your API keys

# =============================================================================
# API KEYS (At least one AI provider required)
# =============================================================================

# OpenAI API Key (for GPT-4)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic API Key (for Claude)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Ollama Host (for local models)
# Default: http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# =============================================================================
# MODEL SETTINGS
# =============================================================================

# Primary reasoning model
PRIMARY_MODEL=gpt-4-turbo-preview

# Vision analysis model
VISION_MODEL=gpt-4-vision-preview

# Claude model for summarization
CLAUDE_MODEL=claude-3-opus-20240229

# Local model (requires Ollama)
LOCAL_MODEL=llama2

# =============================================================================
# SCREEN CAPTURE SETTINGS
# =============================================================================

# OCR refresh rate in seconds
OCR_REFRESH_RATE=2.0

# Screenshot quality (1-100)
SCREENSHOT_QUALITY=95

# OCR language
OCR_LANGUAGE=eng

# =============================================================================
# MEMORY SETTINGS
# =============================================================================

# Database location (defaults to ~/.autodev/memory.db)
# MEMORY_DB_PATH=

# Maximum memory entries to keep
MAX_MEMORY_ENTRIES=10000

# Number of recent entries to include in context
MEMORY_CONTEXT_WINDOW=50

# =============================================================================
# AUTOMATION SETTINGS
# =============================================================================

# Delay between automated actions (seconds)
ACTION_DELAY=0.5

# Typing speed (seconds per character)
TYPING_SPEED=0.05

# Mouse movement duration (seconds)
MOUSE_MOVE_DURATION=0.5

# =============================================================================
# SYSTEM SETTINGS
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Log file location (defaults to ~/.autodev/autodev.log)
# LOG_FILE=

# Maximum retries for failed operations
MAX_RETRIES=3

# Delay between retries (seconds)
RETRY_DELAY=1.0

# =============================================================================
# RUNTIME SETTINGS
# =============================================================================

# Maximum runtime in hours (safety limit)
MAX_RUNTIME_HOURS=24.0

# Health check interval (seconds)
HEALTH_CHECK_INTERVAL=60.0

# Auto cleanup on shutdown
AUTO_CLEANUP=true